{
  "identifier": "lore_recall",
  "version": "1.1.10",
  "name": "Lore Recall",
  "author": "Archkr",
  "github": "https://github.com/archkr/Lumiverse-LoreRecall",
  "homepage": "https://lumiverse.chat",
